        {
          "do": "wait",
          "ms": 2000
        },
        {
          "do": "capture",
          "id": "09b",
          "name": "erreurs-detail-ctrl-o"
        },
        {
          "do": "keys",
          "send": "^o"
        }
      ],
      "files": [
        "config.py"
      ]
    },
