{
  "name": "orchestrator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "bindings": "cd src-tauri && cargo test --lib export_bindings",
    "dev:mock": "vite --open /?mock=long",
    "test": "vitest run --root . --dir e2e/unit",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "virtua": "0.54.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.9",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
